# Default keeps the website working without a Supabase project.
CONTENT_SOURCE=mock
# To connect: set CONTENT_SOURCE=supabase and fill both values below.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required only for website account creation and administrator password resets.
# SERVER ONLY: use a Supabase secret key (sb_secret_...) or legacy service_role key.
# Never prefix this variable with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional temporary server-side login diagnostics. Never logs passwords or tokens.
AUTH_DEBUG=false
